{
  "name": "biaflix-nebula",
  "version": "0.1.1",
  "private": true,
  "description": "Biaflix Nebula: skin cinematografica dark-only per Jellyfin Web 12 con raccolte miste film+serie.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node tools/build.mjs",
    "build:watch": "node tools/build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lint:css": "stylelint \"src/styles/**/*.css\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm typecheck && pnpm lint:css && pnpm test && pnpm build",
    "dev:up": "bash dev/up.sh",
    "dev:down": "bash dev/down.sh",
    "dev:seed": "node dev/seed.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "esbuild": "0.28.2",
    "happy-dom": "21.0.3",
    "lightningcss": "1.33.0",
    "prettier": "3.9.10",
    "stylelint": "17.16.0",
    "stylelint-config-standard": "40.0.0",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
